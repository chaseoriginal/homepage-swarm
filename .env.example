# Values are substituted by Portainer from the stack environment.
# The real values live in the Portainer stack env, NOT in git.
# Copy this file's keys into the Portainer stack env for stack "homepage-swarm".

# Hosts permitted to reach the Homepage UI. Exact Host header match,
# port included when the browser sends it.
HOMEPAGE_ALLOWED_HOSTS=10.77.110.10:3000,10.77.110.10,homepage.echoinggreen.net,localhost:3000,127.0.0.1:3000

# Built-in login gate.
HOMEPAGE_AUTH_ENABLED=true

# Signing/encryption key for the session cookie. openssl rand -base64 32
HOMEPAGE_AUTH_SECRET=REDACTED

# Login password for the built-in gate.
HOMEPAGE_AUTH_PASSWORD=REDACTED

# Absolute URL used to reach Homepage. Update to the proxied URL later.
HOMEPAGE_EXTERNAL_URL=http://10.77.110.10:3000
